{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "prNotPendingHours": 0,
  "minimumReleaseAge": "3 days",
  "schedule": ["at any time"],
  "separateMinorPatch": false,
  "separateMajorMinor": true,
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "labels": ["deps"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.nvmrc$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "description": "Track the RabbitMQ versions in the integration matrix (lines marked '# renovate: rabbitmq')",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/integration\\.yml$/"],
      "matchStrings": ["version: '(?<currentValue>[0-9.]+)'.*# renovate: (?<depName>rabbitmq)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Node runtime: .nvmrc + @types/node in one PR (CI matrix uses bare majors, nothing to track)",
      "groupName": "Node runtime (all files)",
      "matchManagers": ["custom.regex", "npm"],
      "matchDatasources": ["node-version", "npm"],
      "matchPackageNames": ["/^node$/", "@types/node"],
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "labels": ["deps", "node-runtime"]
    },
    {
      "description": "RabbitMQ matrix legs below the newest line take patches only (Docker versioning has no ranges, hence the regex)",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchDepNames": ["rabbitmq"],
      "matchCurrentVersion": "/^(3\\.13|4\\.[0-3])\\./",
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Auto-merge minor/patch for production deps",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "labels": ["deps", "automerge"]
    },
    {
      "description": "Auto-merge all devDependency updates (low risk)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "automerge": false,
      "labels": ["deps", "automerge"]
    },
    {
      "description": "Auto-merge minor/patch GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": false,
      "labels": ["deps", "github-actions", "automerge"]
    },
    {
      "description": "Block automerge for majors",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["deps", "major"]
    },
    {
      "description": "Bypass minimumReleaseAge for lockfile maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "vitest + vite internals co-versioned",
      "groupName": "vite-vitest",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^vite$/", "/^vitest$/", "/^@vitest\\/.+/", "/^vite-/"]
    },
    {
      "description": "@typescript-eslint/* co-versioned monorepo",
      "groupName": "typescript-eslint",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@typescript-eslint\\/.+/", "/^typescript-eslint$/"]
    },
    {
      "description": "@commitlint/* co-versioned monorepo",
      "groupName": "commitlint",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@commitlint\\//"]
    },
    {
      "description": "eslint core + plugins together",
      "groupName": "eslint",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/^eslint$/",
        "/^@eslint\\/.+/",
        "/^eslint-plugin-/",
        "/^eslint-config-/"
      ]
    },
    {
      "description": "engines is a compatibility floor, not a tracked dep",
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
