{
  "name": "@rinaldolabs/sloth-amqp",
  "version": "0.1.0",
  "description": "Node.js TypeScript client for the Sloth delayed-message AMQP service",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "peerDependencies": {
    "amqplib": "^1.0.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/amqplib": "0.10.8",
    "@vitest/coverage-v8": "4.1.5",
    "amqplib": "1.0.6",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.0",
    "lockfile-lint": "5.0.0",
    "prettier": "3.8.3",
    "publint": "^0.3.20",
    "size-limit": "^12.1.0",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.5"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test-once": "vitest --watch=false",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:lockfile": "lockfile-lint",
    "lint:packaging": "publint && attw --pack",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run lint:packaging && npm run size && npm run coverage"
  },
  "keywords": [
    "amqp",
    "rabbitmq",
    "sloth",
    "delayed-messages",
    "typescript"
  ],
  "author": "Emil Rinaldo",
  "homepage": "https://github.com/rinaldolabs/sloth-amqp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinaldolabs/sloth-amqp.git"
  },
  "bugs": {
    "url": "https://github.com/rinaldolabs/sloth-amqp/issues"
  },
  "license": "MIT",
  "private": false
}
